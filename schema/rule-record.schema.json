{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/LLCO/schema/rule-record.schema.json",
  "title": "LLCO rule record (draft 0.1)",
  "description": "One production rule recovered from an AutoLISP estate, stated software-neutrally with its evidence. Field names are proposed, not yet agreed with USG.",
  "type": "object",
  "required": [
    "rule_id",
    "source",
    "statement",
    "targets",
    "evidence_status",
    "authority"
  ],
  "additionalProperties": false,
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+-[A-Z0-9]+-[0-9]{2}$"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "commit",
        "file",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "lines": {
          "type": "string",
          "description": "e.g. '459-465'"
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "statement": {
      "type": "string",
      "description": "The rule in plain, tool-neutral language."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object",
      "description": "Values the rule depends on (thresholds, dimensions, formats), with units."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "geometry",
          "documentation",
          "permits",
          "variation_switching",
          "bom_preparation",
          "business_data",
          "drafting_housekeeping",
          "unresolved"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Functions, files, block definitions, attributes, layers or system variables the rule relies on."
    },
    "evidence_status": {
      "enum": [
        "insufficient",
        "confirmed_positive",
        "confirmed_negative",
        "conflicting"
      ],
      "description": "USG claim status. A rule read from code alone is 'insufficient'. One recorded run confirms behaviour for that input only; a rule is 'confirmed_positive' only when its recorded runs cover the conditions the rule states."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "static_reading",
              "interpreter_probe",
              "recorded_run",
              "human_ruling",
              "source_comment"
            ],
            "description": "interpreter_probe: the extracted logic run outside the original environment (mocks named); never raises a rule to confirmed. recorded_run: the original routine run in its original environment on a fixed input; confirms behaviour for that input only."
          },
          "detail": {
            "type": "string"
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "claimed"
      ],
      "additionalProperties": false,
      "properties": {
        "claimed": {
          "enum": [
            "firm_convention",
            "external_standard",
            "client_requirement",
            "drafting_habit",
            "unknown"
          ]
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legacy_defect": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "suspected",
        "description"
      ],
      "properties": {
        "suspected": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "disposition": {
          "enum": [
            null,
            "keep_for_compatibility",
            "fix",
            "retire"
          ],
          "description": "Decided by the estate's acceptance authority, never by LLCO."
        }
      }
    },
    "required_human_ruling": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
